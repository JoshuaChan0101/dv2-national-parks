    "align": "left",
    "dx": 16,
    "dy": 0,
    "fontSize": 10,
    "fill": "#1F2A24"
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "text": {
     "field": "park"
    }
   }
  },
  {
   "data": {
    "url": "data/park_species.csv"
   },
   "transform": [
    {
     "filter": "datum.class==grp"
    },
    {

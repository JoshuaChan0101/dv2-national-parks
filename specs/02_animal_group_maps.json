    "fill": "#fff",
    "stroke": "#fff",
    "strokeWidth": 3.5
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "text": {
     "field": "park"
    }
   }
  },

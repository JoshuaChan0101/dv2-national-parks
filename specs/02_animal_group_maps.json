    }
   }
  }
 ],
 "config": {
  "font": "Public Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Fraunces",
   "fontSize": 16,
   "anchor": "start",
   "subtitleFontSize": 12,
   "subtitleColor": "#5a665f"
  }
 }
}
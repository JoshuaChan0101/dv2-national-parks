    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "dx": 16,
    "dy": 13,
    "fontSize": 10,
    "fill": "#1F2A24"
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "text": {
